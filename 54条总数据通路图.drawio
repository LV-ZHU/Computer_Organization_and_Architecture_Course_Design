        <mxCell id="rdc" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=18;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=0;size=0.14;rotation=90;" tooltip="rdc_sel[1:0]:00 Rtc;01 IM_15_11;10 31;11 (IM_15_11==0 ?31:IM_15_11). All inputs and Rdc are 5 bits." value="" vertex="1">
          <mxGeometry height="45" width="90" x="767.5" y="392.5" as="geometry" />
        </mxCell>
        <mxCell id="rf" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=22;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;" tooltip="Reads Rsc,Rtc asynchronously. Writes Rdc with Rd on ↑clk if RF_W and Rdc!=0. GPR0 remains zero." value="Regfile" vertex="1">
          <mxGeometry height="190" width="180" x="850" y="470" as="geometry" />
        </mxCell>
        <mxCell id="m3" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=18;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=0;size=0.14;rotation=90;" tooltip="M3:0 Ext5;1 Rs. Data width 32." value="" vertex="1">
          <mxGeometry height="60" width="80" x="1100" y="480" as="geometry" />
        </mxCell>
        <mxCell id="m4" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=18;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=0;size=0.14;rotation=90;" tooltip="M4:0 Rt;1 Ext16. Data width 32." value="" vertex="1">
          <mxGeometry height="60" width="80" x="1100" y="575" as="geometry" />
        </mxCell>
        <mxCell id="alu" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=24;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;" tooltip="ALUC[3:0] uses CPU.v operations 0000..1010. A=alu_a, B=alu_b; output alu_result[31:0]. Comparisons for branches are computed separately from the ALU." value="ALU" vertex="1">
          <mxGeometry height="180" width="135" x="1240" y="470" as="geometry" />
        </mxCell>
        <mxCell id="dmem" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=23;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;" tooltip="DM_Addr=alu_result; DM_Data_in=Rt. Wrapper dmem_addr[12:0]=(DM_Addr-0x10010000)[12:0]. DM_CS=DM_R|DM_W. ↑clk read_data. DM_Size 00/01/10 = byte/half/word; DM_Unsigned=0 sign extension,1 zero extension." value="" vertex="1">
          <mxGeometry height="150" width="150" x="1550" y="485" as="geometry" />
        </mxCell>
        <mxCell id="m2" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=18;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;shape=trapezoid;perimeter=trapezoidPerimeter;fixedSize=0;size=0.14;rotation=270;" tooltip="M2[2:0]:000 alu_result;001 DM_Data_out;010 NPC;011 hi;100 lo;101 cp0_rdata;110 clz32(Rs);111 {Imm16,16&#39;h0}. All inputs and Rd are 32 bits." value="" vertex="1">
          <mxGeometry height="60" width="180" x="780" y="190" as="geometry" />
        </mxCell>
        <mxCell id="control" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;" tooltip="Includes compact rendering of CPU control glue: load_busy toggles on DM_R; load writeback RF_W_raw=load_busy; mdu_busy=mult_unit_busy|div_unit_busy. M1=110 while either busy. RF_W,DM_R,DM_W,hi_write_rs,lo_write_rs,cp0_write,cp0_eret,exception are raw enables gated by !mdu_busy. Start is gated by !mdu_busy. Named local control pins are connections to this control unit." value="Decoder&#xa;Controller" vertex="1">
          <mxGeometry height="80" width="140" x="585" y="200" as="geometry" />
        </mxCell>
        <mxCell id="compare" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=19;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;" tooltip="rs_equal_rt=(Rs==Rt), rs_negative=Rs[31]. beq,bne,bgez use these signals; teq raises exception when equal." value="== / &lt; 0" vertex="1">
          <mxGeometry height="60" width="90" x="1100" y="330" as="geometry" />
        </mxCell>
        <mxCell id="clz" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;" tooltip="clz32(Rs), 32-bit result, returns 32 for input zero." value="CLZ" vertex="1">
          <mxGeometry height="65" width="75" x="1230" y="350" as="geometry" />
        </mxCell>
        <mxCell id="hilo" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=23;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;" tooltip="hi,lo:32 bits. mdu_result=mult_unit_done?mult_unit_result:div_unit_result. mdu_done writes high/low halves. Otherwise hi_write_rs writes Rs to HI, else lo_write_rs writes Rs to LO. Separate HI and LO read outputs feed M2." value="HI / LO" vertex="1">
          <mxGeometry height="150" width="185" x="1450" y="240" as="geometry" />
        </mxCell>
        <mxCell id="mult" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;" tooltip="Inputs Rs,Rt:32. Output mult_unit_result:64. start=mult_start&amp;&amp;!mdu_busy; mult_signed chooses signed/unsigned. mult_unit_busy/done feed control and HI/LO commit." value="Multiplier" vertex="1">
          <mxGeometry height="90" width="135" x="1240" y="705" as="geometry" />
        </mxCell>
        <mxCell id="div" parent="1" style="whiteSpace=wrap;html=0;rounded=0;fillColor=#FFFFFF;strokeColor=#222222;strokeWidth=1.6;fontFamily=Times New Roman;fontSize=20;fontColor=#222222;align=center;verticalAlign=middle;spacing=2;" tooltip="Inputs Rs,Rt:32. div_unit_result[63:32]=remainder, [31:0]=quotient. start=div_start&amp;&amp;!mdu_busy; div_signed selects mode. div_unit_busy/done feed control and HI/LO commit." value="Divider" vertex="1">
          <mxGeometry height="90" width="135" x="1240" y="865" as="geometry" />
        </mxCell>
